--- /dev/null
+++ b/src/themes/croma/index.ts
@@ -0,0 +1,57 @@
+import type { ColorSystemOptions } from '@mui/material/styles';
+import merge from 'lodash-es/merge';
+
+import { DEFAULT_COLOR_SCHEME } from '../_base/theme';
+
+/** The "Croma" color scheme (identidade v0.1 "Barras"). */
+const theme = merge<ColorSystemOptions, ColorSystemOptions, ColorSystemOptions>(
+    {},
+    DEFAULT_COLOR_SCHEME,
+    {
+        palette: {
+            primary: {
+                main: '#f2f2f0', // Fósforo
+                contrastText: '#0b0b0c'
+            },
+            secondary: {
+                main: '#f2f2f0'
+            },
+            background: {
+                default: '#0b0b0c', // Sinal
+                paper: '#17181a' // Grafite
+            },
+            text: {
+                primary: '#f2f2f0',
+                secondary: '#a3a3a0' // Névoa
+            },
+            divider: '#2a2b2e', // Linha
+            starIcon: {
+                main: '#c0c000'
+            },
+            error: {
+                main: '#c00000'
+            },
+            action: {
+                focus: 'rgba(242, 242, 240, 0.16)',
+                hover: 'rgba(242, 242, 240, 0.08)'
+            },
+            Alert: {
+                infoFilledBg: '#17181a',
+                infoFilledColor: '#f2f2f0'
+            },
+            AppBar: {
+                defaultBg: '#0b0b0c'
+            },
+            Button: {
+                inheritContainedBg: '#17181a',
+                inheritContainedHoverBg: '#2a2b2e'
+            },
+            SnackbarContent: {
+                bg: '#17181a',
+                color: '#f2f2f0'
+            }
+        }
+    }
+);
+
+export default theme;
diff --git a/src/themes/croma/theme.scss b/src/themes/croma/theme.scss
new file mode 100644
index 000000000..68c2eaf14
--- /dev/null
+++ b/src/themes/croma/theme.scss
@@ -0,0 +1,122 @@
+/* Croma: identidade v0.1 "Barras" (identidade/v0.1-barras/MANUAL.md) */
+
+/* Import the base theme with overrides */
+@use '../_base/theme' with (
+    // Color palette
+    $background-default: #0b0b0c, // Sinal
+    $background-paper: #17181a, // Grafite
+    $primary-main: #f2f2f0, // Fósforo: botão principal e foco
+    $primary-dark: #a3a3a0,
+    $primary-light: #fff,
+    $primary-hover: rgba(242, 242, 240, 0.12),
+    $primary-contrastText: #0b0b0c,
+    $error-main: #c00000,
+    $error-dark: #8a0000,
+    $error-light: #e04040,
+    $error-contrastText: #f2f2f0,
+    $text-primary: #f2f2f0,
+    $text-secondary: #a3a3a0, // Névoa
+    $action-focus: rgba(242, 242, 240, 0.16),
+    $action-hover: rgba(242, 242, 240, 0.08),
+    $divider: #2a2b2e, // Linha
+
+    // Components
+    $appBar-defaultBg: #0b0b0c,
+    $appBar-transparentBg: rgba(11, 11, 12, 0.6),
+    $filledInput-bg: #17181a,
+    $filledInput-borderColor: #2a2b2e,
+    $card-borderRadius: 0,
+    $alert-infoFilledBg: #17181a,
+    $alert-infoFilledColor: #f2f2f0,
+    $button-inheritContainedBg: #17181a,
+    $button-inheritContainedHoverBg: #2a2b2e,
+    $snackbarContent-bg: #17181a,
+    $snackbarContent-color: #f2f2f0,
+    $surface-overlay: #17181a
+);
+
+/* Cores das bibliotecas: barras do padrão de teste em 75% */
+:root {
+    --croma-sinal: #0b0b0c;
+    --croma-grafite: #17181a;
+    --croma-linha: #2a2b2e;
+    --croma-cinza: #8a8b8e;
+    --croma-nevoa: #a3a3a0;
+    --croma-fosforo: #f2f2f0;
+    --croma-inicio: #c0c0c0;
+    --croma-filmes: #c0c000;
+    --croma-series: #00c0c0;
+    --croma-musica: #00c000;
+    --croma-fotos: #c000c0;
+    --croma-tv: #c00000;
+    --croma-livros: #0000c0;
+    --croma-livros-legivel: #3b3bff;
+    --croma-espectro:
+        linear-gradient(
+            90deg,
+            #5a00b4 0%,
+            #2a2aff 18%,
+            #00c0c0 36%,
+            #00c000 52%,
+            #c0c000 68%,
+            #e07000 82%,
+            #c00000 100%
+        );
+
+    scrollbar-color: #2a2b2e #0b0b0c;
+}
+
+/* Cantos vivos em tudo. A única curva da marca é a do aparelho, que não existe na interface. */
+*,
+*::before,
+*::after {
+    border-radius: 0 !important;
+}
+
+/* Foco: sempre Fósforo */
+.layout-desktop .card:focus-visible .cardScalable {
+    outline: 4px solid var(--croma-fosforo);
+    outline-offset: 0;
+}
+
+.layout-tv .card:focus .cardScalable,
+.layout-tv .card.show-focus:focus .cardScalable {
+    box-shadow: none;
+    outline: 8px solid var(--croma-fosforo);
+    outline-offset: 0;
+}
+
+/* Fundos de cartão sem arte: neutros, sem o azul do Jellyfin. A "capa gerada" substitui isto depois. */
+.defaultCardBackground1,
+.defaultCardBackground3,
+.defaultCardBackground5 {
+    background-color: #17181a;
+}
+
+.defaultCardBackground2,
+.defaultCardBackground4 {
+    background-color: #2a2b2e;
+}
+
+/* Títulos em Fósforo; o texto corrido continua em Névoa */
+h1,
+h2,
+.pageTitle,
+.sectionTitle {
+    color: var(--croma-fosforo);
+}
+
+/* Botão de alfabeto selecionado */
+.alphaPickerButton-selected {
+    background-color: var(--croma-fosforo);
+    color: var(--croma-sinal);
+}
+
+/* Detail ribbon on item details pages */
+.detailRibbon {
+    background: rgba(11, 11, 12, 0.8);
+
+    .layout-tv & {
+        background: none;
+    }
+}
